{
    "configMigration": true,
    "extends": [
        "security:gomodIndirectSecurityUpdates"
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "groupName": "vulnerable dependencies"
    },
    "gitAuthor": "Renovate Bot <738953+christianhuening@users.noreply.github.com>",
    "gitIgnoredAuthors": [
        "renovate@whitesourcesoftware.com"
    ],
    "assignees": [
        "christianhuening"
    ],
    "baseBranchPatterns": [
        "main"
    ],
    "automerge": false,
    "dependencyDashboard": true,
    "platformAutomerge": true,
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "lockFileMaintenance": {
        "enabled": false
    },
    "forkProcessing": "enabled",
    "enabledManagers": [
        "gomod",
        "custom.regex",
        "github-actions",
        "dockerfile"
    ],
    "prCreation": "immediate",
    "recreateWhen": "always",
    "rebaseWhen": "behind-base-branch",
    "semanticCommits": "disabled",
    "addLabels": [
        "version-bump"
    ],
    "separateMajorMinor": true,
    "separateMultipleMajor": true,
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^charts/images.yaml$/"
            ],
            "matchStrings": [
                "tag: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\n"
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^hack/tools/install\\.sh$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\s+VERSION=(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "Tool versions pinned as `go run <module>@<version>` inside workflow run: blocks are invisible to the gomod and github-actions managers.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\s+run: go run \\S+@(?<currentValue>v\\S+)"
            ]
        },
        {
            "description": "GOTOOLCHAIN pinned in the Makefile (gardener's convention), invisible to the gomod manager.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^Makefile$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\s+export GOTOOLCHAIN := go(?<currentValue>\\S+)"
            ]
        }
    ],
    "packageRules": [
        {
            "matchManagers": [
                "gomod"
            ],
            "groupName": "k8s",
            "matchPackageNames": [
                "k8s.io/api",
                "k8s.io/apiextensions-apiserver",
                "k8s.io/apimachinery",
                "k8s.io/client-go",
                "k8s.io/code-generator",
                "k8s.io/component-base",
                "k8s.io/kubelet"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "addLabels": [
                "go module"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "groupName": "gardener",
            "matchPackageNames": [
                "github.com/gardener/gardener",
                "github.com/gardener/gardener/pkg/apis",
                "github.com/gardener/gardener/hack/tools",
                "github.com/gardener/etcd-druid/api"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/api",
                "k8s.io/apiextensions-apiserver",
                "k8s.io/apimachinery",
                "k8s.io/apiserver",
                "k8s.io/client-go",
                "k8s.io/code-generator",
                "k8s.io/component-base",
                "k8s.io/kubelet"
            ],
            "allowedVersions": "<0.38.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "sigs.k8s.io/controller-runtime"
            ],
            "allowedVersions": "<0.26.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "sigs.k8s.io/controller-tools"
            ],
            "allowedVersions": "<0.23.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/autoscaler/vertical-pod-autoscaler"
            ],
            "allowedVersions": "<1.8.0"
        },
        {
            "description": "Caps only hack/tools/install.sh's helm, which is used solely by hack/ci/*.sh (helm repo add/update/template) — that flow is unvalidated on Helm 4 and every chart here is still Chart apiVersion v1. Gardener's tools.mk pins its own separate helm binary at v4.2.4, so aligning is a deliberate migration, not a routine bump.",
            "matchPackageNames": [
                "helm/helm"
            ],
            "allowedVersions": "<4.0.0"
        },
        {
            "matchFileNames": [
                "charts/images.yaml"
            ],
            "addLabels": [
                "image"
            ]
        },
        {
            "description": "Follow gardener's Go line: gardener v1.153 builds on go 1.26.x. Caps the go/toolchain directives, the Makefile GOTOOLCHAIN and the golang builder image below 1.27 until gardener moves; patch releases still flow.",
            "matchDatasources": [
                "golang-version",
                "docker"
            ],
            "matchPackageNames": [
                "go",
                "golang"
            ],
            "allowedVersions": "<1.27"
        }
    ]
}
