{
    "configMigration": true,
    "assignees": [
        "christianhuening"
    ],
    "baseBranchPatterns": [
        "main"
    ],
    "automerge": false,
    "dependencyDashboard": true,
    "platformAutomerge": true,
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "lockFileMaintenance": {
        "enabled": false
    },
    "forkProcessing": "enabled",
    "enabledManagers": [
        "gomod",
        "custom.regex",
        "github-actions",
        "dockerfile"
    ],
    "prCreation": "immediate",
    "recreateWhen": "always",
    "semanticCommits": "disabled",
    "addLabels": [
        "version-bump"
    ],
    "separateMajorMinor": true,
    "separateMultipleMajor": true,
    "postUpdateOptions": [
        "gomodTidy"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^charts/images.yaml$/"
            ],
            "matchStrings": [
                "tag: (?<currentValue>.+?) # renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\n"
            ]
        },
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^hack/tools/install\\.sh$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\s+VERSION=(?<currentValue>\\S+)"
            ]
        },
        {
            "description": "Tool versions pinned as `go run <module>@<version>` inside workflow run: blocks are invisible to the gomod and github-actions managers.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.+?) depName=(?<depName>.+?)( versioning=(?<versioning>.+?))?\\s+run: go run \\S+@(?<currentValue>v\\S+)"
            ]
        }
    ],
    "packageRules": [
        {
            "matchManagers": [
                "gomod"
            ],
            "groupName": "k8s",
            "matchPackageNames": [
                "k8s.io/api",
                "k8s.io/apiextensions-apiserver",
                "k8s.io/apimachinery",
                "k8s.io/client-go",
                "k8s.io/code-generator",
                "k8s.io/component-base",
                "k8s.io/kubelet"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "addLabels": [
                "go module"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "groupName": "gardener",
            "matchPackageNames": [
                "github.com/gardener/gardener",
                "github.com/gardener/gardener/pkg/apis",
                "github.com/gardener/gardener/hack/tools",
                "github.com/gardener/etcd-druid/api"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/api",
                "k8s.io/apiextensions-apiserver",
                "k8s.io/apimachinery",
                "k8s.io/apiserver",
                "k8s.io/client-go",
                "k8s.io/code-generator",
                "k8s.io/component-base",
                "k8s.io/kubelet"
            ],
            "allowedVersions": "<0.37.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "sigs.k8s.io/controller-runtime"
            ],
            "allowedVersions": "<0.25.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "sigs.k8s.io/controller-tools"
            ],
            "allowedVersions": "<0.22.0"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "k8s.io/autoscaler/vertical-pod-autoscaler"
            ],
            "allowedVersions": "<1.8.0"
        },
        {
            "description": "go-openapi cut v1.0.0 from the v0 line. Because Go treats v0 and v1 as the same module path, this major-semantics jump shows up as a routine update. gardener deliberately stays on the v0 line, so do not get ahead of it.",
            "matchManagers": [
                "gomod"
            ],
            "matchPackageNames": [
                "github.com/go-openapi/jsonpointer",
                "github.com/go-openapi/jsonreference"
            ],
            "allowedVersions": "<1.0.0"
        },
        {
            "description": "Caps only hack/tools/install.sh's helm, which is used solely by hack/ci/*.sh (helm repo add/update/template) — that flow is unvalidated on Helm 4 and every chart here is still Chart apiVersion v1. Gardener's tools.mk pins its own separate helm binary at v4.2.3, so aligning is a deliberate migration, not a routine bump.",
            "matchPackageNames": [
                "helm/helm"
            ],
            "allowedVersions": "<4.0.0"
        },
        {
            "matchFileNames": [
                "charts/images.yaml"
            ],
            "addLabels": [
                "image"
            ]
        }
    ]
}
